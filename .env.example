# Sanity (free plan). Create a project at https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Shared secret for POST /api/revalidate (Sanity webhook)
SANITY_REVALIDATE_SECRET=
# Write token for one-time content import (scripts/import-cms-content.ts). Not needed at runtime.
SANITY_API_WRITE_TOKEN=
# Optional Search Console verification
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
